prefix=${pcfiledir}/@PC_TO_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: yoke-sdk-cpp
Description: The C++ libraries a Plugin unit and an interface client of Yoke are written with
Version: @PROJECT_VERSION@
Requires: grpc++ protobuf openssl
Libs: -L${libdir} -lyoke-cpp -lpthread
Cflags: -I${includedir}
