# The C++ family, for find_package(yoke-sdk-cpp): the target yoke::yoke-cpp and what it links against.
@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(PkgConfig)
pkg_check_modules(GRPCXX REQUIRED IMPORTED_TARGET grpc++)
pkg_check_modules(PROTOBUF REQUIRED IMPORTED_TARGET protobuf)
find_dependency(Threads)
find_dependency(OpenSSL 3)
include("${CMAKE_CURRENT_LIST_DIR}/yoke-sdk-cpp-targets.cmake")
check_required_components(yoke-sdk-cpp)
